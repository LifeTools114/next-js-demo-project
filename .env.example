# ─────────────────────────────────────────────────────────────
# 쿠팡 파트너스 Open API (서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요)
#
# 파트너스 "최종 승인"(제휴링크 누적 판매 15만원) 이후에만 키가 발급됩니다.
# 키가 없으면 서비스는 자동으로 내장 예시 데이터로 동작합니다.
# ─────────────────────────────────────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 딥링크 성과 추적용 서브 아이디 (선택)
COUPANG_SUB_ID=

# ─────────────────────────────────────────────────────────────
# 환율 (KRW → VND) — 클라이언트에도 노출되는 값입니다.
# ─────────────────────────────────────────────────────────────
# 1 KRW = ? VND
NEXT_PUBLIC_KRW_TO_VND=18.5
# 환전 스프레드 (0.015 = 1.5%)
NEXT_PUBLIC_FX_SPREAD=0.015
# 환율 기준일 표기 (선택)
NEXT_PUBLIC_FX_UPDATED_AT=

# ─────────────────────────────────────────────────────────────
# 운영자 콘솔 (매입 원가·마진·고객 개인정보를 다루므로 반드시 설정)
# 미설정 시 개발 환경에서만 통과하고 프로덕션에서는 차단됩니다.
# ─────────────────────────────────────────────────────────────
ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────
# 수금 계좌 (은행이체 · 수동 확인)
# 고객 예수금과 운영 자금은 계좌부터 분리하는 것을 권장합니다.
# ─────────────────────────────────────────────────────────────
VN_BANK_NAME=
VN_BANK_ACCOUNT=
VN_BANK_HOLDER=

# ─────────────────────────────────────────────────────────────
# 전자지갑·PG (선택 — 설정하면 주문서 결제수단 목록에 자동으로 나타납니다)
# ─────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
