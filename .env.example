# ─────────────────────────────────────────────────────────────
# 쿠팡 파트너스 (제휴 링크 생성 전용 — 서버에서만 사용)
#
# 카탈로그 수집이 아니라 "딥링크 생성"에만 씁니다.
# 이것이 파트너스 프로그램의 본래 용도라 약관 정합성 문제가 없습니다.
# 키가 없으면 원본 쿠팡 링크로 폴백하며 서비스는 정상 동작합니다.
# ─────────────────────────────────────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 파트너스 채널 아이디 — 모든 제휴 링크에 이 값이 붙어야 수수료가 귀속됩니다.
COUPANG_SUB_ID=acma2000

# ─────────────────────────────────────────────────────────────
# 환율 (확장프로그램에도 전달되는 값)
# 상품가는 KRW, 국제운임은 USD, 고객 결제는 VND 라 통화가 셋입니다.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_USD_TO_KRW=1380
NEXT_PUBLIC_KRW_TO_VND=18.5
NEXT_PUBLIC_FX_SPREAD=0.015
NEXT_PUBLIC_FX_UPDATED_AT=
# 환율 자동 갱신 — 확장 설정·견적 API 가 불릴 때 오래됐으면 스스로 갱신합니다.
# 위 NEXT_PUBLIC_* 값은 첫 부팅·API 실패 시의 안전 기본값이 됩니다.
FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
FX_REFRESH_HOURS=12

# ─────────────────────────────────────────────────────────────
# 운영자 콘솔 (매입 원가·마진·고객 개인정보를 다루므로 반드시 설정)
# 미설정 시 개발 환경에서만 통과하고 프로덕션에서는 차단됩니다.
# ─────────────────────────────────────────────────────────────
ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────
# 수금 계좌 — 동화(VND)·원화(KRW) 두 계좌 모두 받습니다.
# 확정 계좌(VN: 우리은행 베트남 / KR: KB국민은행, 예금주 박승우)가
# 기본값으로 내장돼 있어 비워도 됩니다. 계좌를 바꾸면 여기서 덮어쓰세요.
# ─────────────────────────────────────────────────────────────
VN_BANK_NAME=
VN_BANK_ACCOUNT=
VN_BANK_HOLDER=
KR_BANK_NAME=
KR_BANK_ACCOUNT=
KR_BANK_HOLDER=

# ─────────────────────────────────────────────────────────────
# 입금 자동 확인 웹훅 (POST /api/payment/webhook)
# 은행 입금 알림 서비스(베트남: Casso·SePay 계열, 한국: 오픈뱅킹·가상계좌)를
# 연결하면 이체 메모의 주문번호로 결제 확인까지 자동 처리됩니다.
# 토큰 미설정 시 엔드포인트는 비활성입니다. 대조 실패 건은
# .data/payment-review.jsonl 에 쌓입니다.
# ─────────────────────────────────────────────────────────────
PAYMENT_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────
# 한국 물류창고 (배송대행 입고지) — 파트너 확정값이 코드 기본값으로
# 내장되어 있어 비워도 됩니다. 파트너가 바뀌면 여기서 덮어쓰세요.
#   기본: 서울특별시 강서구 개화동로 11길 5 (07504)
#   세부주소 규칙: K-ECOM(주문자명) — KR_WAREHOUSE_CODE 로 접두사 변경
# ─────────────────────────────────────────────────────────────
KR_WAREHOUSE_NAME=
KR_WAREHOUSE_ZIP=
KR_WAREHOUSE_ADDR1=
KR_WAREHOUSE_ADDR2=
KR_WAREHOUSE_CODE=
KR_WAREHOUSE_PHONE=

# ─────────────────────────────────────────────────────────────
# 상태 전이 알림 (선택) — 주문 상태가 바뀔 때마다 이 웹훅으로 전송
# Slack/Discord/카카오워크 등 아무 웹훅 URL 이나 됩니다.
# 미설정이어도 .data/notifications.jsonl 에는 항상 기록됩니다.
# ─────────────────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# 텔레그램 연동 — 물류 파트너 자동화 (docs/OPERATIONS.md 텔레그램 절)
# 파트너 방의 한 줄 메시지("K-ECOM(이름) 1.42kg", "배달완료 HN…")가
# 입고 실측·현황·배송일정·배달완료 처리로 이어지고, 일괄 발송 시
# 적하목록 CSV 가 파트너 방으로 자동 전송됩니다.
#   1) @BotFather 로 봇 생성 → TOKEN
#   2) 봇을 파트너 방에 초대 후 방 ID 확인 → PARTNER_CHAT_ID
#   3) BASE_URL 설정 후: npm run telegram:webhook
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PARTNER_CHAT_ID=
TELEGRAM_OPERATOR_CHAT_ID=
BASE_URL=

# ─────────────────────────────────────────────────────────────
# 전자지갑·PG (선택 — 설정하면 주문서 결제수단 목록에 자동으로 나타납니다)
# ─────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ─────────────────────────────────────────────────────────────
# 점검 시간대 (쉬는시간) — 기본: 매일 03:00~03:30 한국시간 (하노이 01:00~01:30)
# 쿠팡 점검 일정이 바뀌었는데 배포가 늦을 때 1로 설정하면 창이 즉시 꺼집니다.
# 시각 변경은 config/maintenance.js 의 startMinuteOfDay 를 수정하세요.
# ─────────────────────────────────────────────────────────────
MAINTENANCE_DISABLED=
