{
  "manifest_version": 3,
  "name": "베트남 직구 도우미",
  "version": "0.9.7",
  "description": "한국 온라인몰 상품의 베트남 도착 예상 가격을 계산하고, 배송지 입력 방법을 안내합니다. 화면을 대신 조작하지 않습니다.",
  "default_locale": "ko",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://m.coupang.com/*",
    "https://mc.coupang.com/*",
    "https://checkout.coupang.com/*",
    "https://cart.coupang.com/*",
    "https://*.1dollartool.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coupang.com/vp/products/*",
        "https://m.coupang.com/vm/products/*"
      ],
      "js": [
        "src/content/patterns.js",
        "vendor/calc.js",
        "src/content/extract.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mc.coupang.com/*",
        "https://m.coupang.com/*",
        "https://www.coupang.com/*",
        "https://checkout.coupang.com/*",
        "https://cart.coupang.com/*"
      ],
      "js": [
        "src/content/patterns.js",
        "vendor/calc.js",
        "src/content/parse-page.js",
        "src/content/order-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "베트남 직구 도우미",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
