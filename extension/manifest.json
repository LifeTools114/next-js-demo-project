{
  "manifest_version": 3,
  "name": "쿠팡 하노이 직구 도우미",
  "version": "0.3.0",
  "description": "쿠팡 상품의 하노이 도착 가격을 바로 계산합니다. 무게 추정, 국제배송비, 배송 가능 여부 확인.",
  "default_locale": "ko",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://m.coupang.com/*",
    "https://mc.coupang.com/*",
    "https://checkout.coupang.com/*",
    "https://cart.coupang.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coupang.com/vp/products/*",
        "https://m.coupang.com/vm/products/*"
      ],
      "js": [
        "vendor/calc.js",
        "src/content/extract.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mc.coupang.com/*",
        "https://m.coupang.com/*",
        "https://www.coupang.com/*",
        "https://checkout.coupang.com/*",
        "https://cart.coupang.com/*"
      ],
      "js": [
        "vendor/calc.js",
        "src/content/parse-page.js",
        "src/content/order-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://postcode.map.daum.net/*"],
      "js": ["src/content/postcode-fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "하노이 직구 도우미",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
