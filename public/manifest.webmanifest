{
  "name": "베트남 직구",
  "short_name": "베트남 직구",
  "description": "한국 쇼핑몰 상품을 베트남까지 — 도착 가격 계산과 배송·구매 신청",
  "id": "/",
  "start_url": "/send?src=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "ko",
  "background_color": "#0a2e9c",
  "theme_color": "#0a2e9c",
  "icons": [
    {
      "src": "/icons/192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/send",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shots",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "📦 배송만 신청",
      "url": "/send?track=forwarding&src=shortcut"
    },
    {
      "name": "🛒 구매하고 배송까지 신청",
      "url": "/send?track=agent&src=shortcut"
    },
    {
      "name": "📋 주문조회",
      "url": "/orders?src=shortcut"
    }
  ]
}
