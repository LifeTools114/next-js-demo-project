# ─── 서버(공개) 환경변수 예시 — 실제 값은 서버의 .env.local 에만 두고 절대 커밋하지 마세요 ───

# [필수] 운영자 인증 — /admin 과 운영 API. 길고 무작위로 (예: openssl rand -hex 24)
ADMIN_TOKEN=

# [필수] 사이트 주소 — 텔레그램 알림의 링크, 확장 안내에 쓰입니다 (끝에 / 없이)
BASE_URL=https://naka.1dollartool.com

# [권장] PIN 잠금 해제 표시 서명 비밀 — 없으면 서버가 재시작할 때마다 고객이 PIN 을 다시 넣습니다
SESSION_SECRET=

# [권장] 텔레그램 알림 — @BotFather 에서 봇 만들고, 채팅 ID 는 봇에게 말 건 뒤 getUpdates 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_PARTNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# [선택] 입금 확인 웹훅을 쓸 때만 — 은행 앱/자동화가 이 토큰으로 부릅니다
PAYMENT_WEBHOOK_TOKEN=

# [선택] 환율 — 비우면 코드 기본값·자동 갱신(FX_SOURCE_URL)을 씁니다
# NEXT_PUBLIC_KRW_TO_VND=18.5
# NEXT_PUBLIC_USD_TO_KRW=1380
# FX_REFRESH_HOURS=6

# [선택] 창고·계좌·사업자 정보 — 코드 기본값(config/)과 다를 때만 넣습니다
# KR_WAREHOUSE_PHONE=010-4803-6031
# KR_BANK_ACCOUNT= / KR_BANK_HOLDER= / VN_BANK_ACCOUNT= / VN_BANK_HOLDER=
# COMPANY_BRAND=YS-ECOM 베트남 직구

# [선택] 주문·고객 파일 위치 — 기본 .data (백업 대상)
# ORDER_STORE_DIR=/srv/kb/.data
